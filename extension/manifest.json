{
  "manifest_version": 3,
  "name": "HOYO AIO",
  "version": "0.1.0",
  "description": "원신과 붕괴: 스타레일의 호요랩 출석을 한곳에서 관리합니다.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://sg-hk4e-api.hoyolab.com/*", "https://sg-public-api.hoyolab.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "HOYO AIO" }
}
