{
  "manifest_version": 3,
  "name": "HOYO All-in-one",
  "version": "0.4.2",
  "description": "원신·스타레일 출석, 프로필, 전적과 가챠 계획을 한곳에서 관리합니다.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://sg-hk4e-api.hoyolab.com/*",
    "https://sg-public-api.hoyolab.com/*",
    "https://bbs-api-os.hoyolab.com/*",
    "https://sg-act-public-api.hoyolab.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HOYO All-in-one"
  }
}
